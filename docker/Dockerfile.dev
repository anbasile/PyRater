# Minimal dev/test image: no CmdStan, no compiler toolchain.
# Used for fast unit tests, ruff, and ty — the repo is bind-mounted at runtime,
# nothing is baked into the image except the interpreter and uv itself.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_CACHE_DIR=/uv-cache
WORKDIR /app
