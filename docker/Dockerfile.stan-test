# Adds only what CmdStan's build needs (a C++ toolchain) on top of the
# minimal dev image -- everything else (deps, CmdStan itself) lives in
# podman-managed volumes, not baked into the image, so this stays a thin
# "toolchain" layer rather than growing every time CmdStan is upgraded.
FROM python:3.12-slim
RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends g++ make \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_CACHE_DIR=/uv-cache
WORKDIR /app
